terraform {
  required_version = ">= 1.3.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "{{ config.project.region }}"
}


{% for name, resource in resources.network %}

resource "aws_vpc" "{{ name }}" {
  cidr_block = "{{ resource.cidr }}"

  tags = {
    Name = "{{ config.project.name }}-{{ name }}"
  }
}

{% endfor %}


{% for name, resource in resources.compute %}

resource "aws_instance" "{{ name }}" {
  ami           = "{{ resource.ami or 'ami-0c02fb55956c7d316' }}"
  instance_type = "{{ resource.instance_type }}"

  tags = {
    Name = "{{ config.project.name }}-{{ name }}"
  }
}

{% endfor %}


{% for name, resource in resources.database %}

resource "aws_db_instance" "{{ name }}" {
  allocated_storage   = 20
  engine              = "{{ resource.engine }}"
  engine_version      = "{{ resource.version }}"
  instance_class      = "{{ resource.instance_class }}"
  username            = "admin"
  password            = "AutoDevOpsDemo123!"
  skip_final_snapshot = true

  tags = {
    Name = "{{ config.project.name }}-{{ name }}"
  }
}

{% endfor %}